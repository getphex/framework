includes:
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    phpVersion: 80300
    paths:
        - src
        - tests
        - examples
    tmpDir: var/cache/phpstan
    parallel:
        maximumNumberOfProcesses: 1
