includes:
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    phpVersion: 80300
    fileExtensions: [php, stub]
    paths:
        - src
        - tests
        - examples
        - bin/phex
        - stubs/application
        - var/generated
    scanFiles:
        - src/Runtime/Elephc/analysis.stub
    tmpDir: var/cache/phpstan
    parallel:
        maximumNumberOfProcesses: 1
