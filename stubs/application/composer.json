{
    "name": "getphex/app",
    "description": "An application built with Phex.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "getphex/phex": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\Generated\\": "var/generated/",
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "@php -S 127.0.0.1:8080 -t public public/index.php",
        "build": "phex build config/build.php",
        "build:native": "phex compile config/build.php"
    }
}
