#!/usr/bin/env php
<?php

declare(strict_types=1);

use Phex\Build\Compiler\BuildConfig;
use Phex\Build\Compiler\ContainerCompiler;

require __DIR__.'/../vendor/autoload.php';

if (!isset($argv) || count($argv) !== 3 || $argv[1] !== 'build') {
    fwrite(STDERR, "Usage: php bin/phex build <config.php>\n");
    exit(1);
}

try {
    // Trusted, build-time project configuration. Never loaded on the request path.
    $config = require $argv[2];
    if (!$config instanceof BuildConfig) {
        throw new InvalidArgumentException('Build configuration must return a BuildConfig.');
    }
    $changed = (new ContainerCompiler())->build($config);
    fwrite(STDOUT, ($changed ? 'Generated ' : 'Already current: ').$config->output."\n");
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage()."\n");
    exit(1);
}
