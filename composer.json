{
    "name": "getphex/phex",
    "description": "A PHP web framework designed for native ElephC compilation.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Phex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phex\\Tests\\": "tests/",
            "Phex\\Examples\\HelloWorld\\": "examples/hello-world/",
            "Phex\\Examples\\JsonApi\\": "examples/json-api/",
            "Phex\\Examples\\RequestLifecycle\\": "examples/request-lifecycle/",
            "Phex\\Examples\\CompiledContainer\\Generated\\": "var/generated/example/",
            "Phex\\Examples\\CompiledContainer\\": "examples/compiled-container/",
            "Phex\\Tests\\Generated\\": "var/generated/tests/",
            "App\\Generated\\": "stubs/application/var/generated/",
            "App\\": "stubs/application/app/"
        }
    },
    "scripts": {
        "tools:install": "@composer --working-dir=tools/phpstan install --no-interaction --prefer-dist",
        "analyse": [
            "@generate",
            "@analyse:phpstan"
        ],
        "check": [
            "@generate",
            "@analyse:phpstan",
            "@test:build",
            "@test:application",
            "@test:http",
            "@test:native-lifecycle",
            "@test:compatibility"
        ],
        "test": [
            "@generate",
            "@test:build",
            "@test:application",
            "@test:http",
            "@test:native-lifecycle",
            "@test:compatibility"
        ],
        "test:php": [
            "@generate",
            "phpunit"
        ],
        "test:elephc": [
            "@generate",
            "elephc test tests/Compatibility --strict-php"
        ],
        "generate": [
            "@php bin/phex build examples/compiled-container/container.php",
            "@php bin/phex build tests/Build/failing-application.php",
            "@php bin/phex build tests/Build/failing-request.php",
            "@php bin/phex build tests/Build/compiled-routing.php",
            "@php bin/phex build tests/Build/empty-routing.php",
            "@php bin/phex build tests/Build/named-routing.php",
            "@php bin/phex build tests/Build/configuration.php",
            "@php bin/phex build stubs/application/config/build.php"
        ],
        "analyse:phpstan": "tools/phpstan/vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "test:build": "phpunit --testsuite Build",
        "test:compatibility": "python3 tools/checks/compatibility.py",
        "test:http": "python3 tools/checks/http_smoke.py",
        "build:web": [
            "@generate",
            "python3 tools/builds/elephc_web.py"
        ],
        "test:application": "python3 tools/checks/application_smoke.py",
        "test:native-lifecycle": "python3 tools/checks/native_lifecycle.py"
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/phex"
    ]
}
