{
    "name": "getphex/phex",
    "description": "A PHP web framework designed for native ElephC compilation.",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Phex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phex\\Tests\\": "tests/",
            "Phex\\Examples\\HelloWorld\\": "examples/hello-world/",
            "Phex\\Examples\\JsonApi\\": "examples/json-api/",
            "Phex\\Examples\\RequestLifecycle\\": "examples/request-lifecycle/"
        }
    },
    "scripts": {
        "tools:install": "@composer --working-dir=tools/phpstan install --no-interaction --prefer-dist",
        "analyse": "tools/phpstan/vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "check": [
            "@analyse",
            "@test"
        ],
        "test": "python3 tools/checks/compatibility.py",
        "test:php": "phpunit",
        "test:elephc": "elephc test tests/Compatibility --strict-php"
    },
    "config": {
        "sort-packages": true
    }
}
